{
  "name": "hehe-toolbox",
  "productName": "核核工具箱",
  "version": "0.8.6",
  "description": "核核工具箱 —— 本地优先、轻量聚合的桌面效率工具箱",
  "main": "main.js",
  "author": "hehe",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-tests.js",
    "dist": "electron-builder --win portable && node scripts/pack-zip.js",
    "dist:installer": "node scripts/check-installer-name.js && electron-builder --win nsis",
    "dist:retry": "bash scripts/build-portable.sh D:/zcode/hehe/dist 3",
    "version:check": "node scripts/version.js",
    "version:bump": "node scripts/version.js --next",
    "lint": "eslint .",
    "test:unit": "node scripts/run-tests.js --unit",
    "test:ui": "node scripts/run-tests.js --ui",
    "test:count": "node scripts/check-assertion-count.js",
    "test:count:write": "node scripts/check-assertion-count.js --write",
    "typecheck": "tsc -p jsconfig.json",
    "test:list": "node scripts/run-tests.js --list"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.1",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "jsqr": "^1.4.0",
    "marked": "^12.0.2",
    "opencc-js": "^1.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "qrcode": "^1.5.4",
    "solarlunar": "^2.0.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "^43.8.4",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.hehe.toolbox",
    "productName": "核核工具箱",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "splash.html",
      "ruler.html",
      "pin.html",
      "snip.html",
      "css/**/*",
      "js/**/*",
      "lib/**/*",
      "ipc/**/*",
      "assets/**/*",
      "!assets/splash.bmp",
      "package.json",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/build/*.map",
      "!node_modules/pdfjs-dist/build/pdf.js",
      "!node_modules/pdfjs-dist/build/pdf.worker.js",
      "!node_modules/pdfjs-dist/build/pdf.sandbox.js",
      "!node_modules/pdfjs-dist/build/pdf.sandbox.min.js",
      "!node_modules/pdfjs-dist/build/pdf.sandbox.js.map",
      "!node_modules/pdfjs-dist/build/pdf.worker.entry.js",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/7zip-bin/linux/**",
      "!node_modules/7zip-bin/mac/**",
      "!node_modules/7zip-bin/win/arm64/**",
      "!node_modules/7zip-bin/win/ia32/**",
      "!node_modules/canvas/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/tesseract.js/docs/**",
      "!node_modules/tesseract.js/scripts/**",
      "!node_modules/tesseract.js/src/**",
      "!node_modules/tesseract.js/examples/**",
      "!node_modules/opencc-js/dist/esm-lib/**",
      "!node_modules/pdf-lib/cjs/**",
      "!node_modules/pdf-lib/es/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "hehe-toolbox-Portable-${version}.exe",
      "splashImage": "assets/splash.bmp",
      "unpackDirName": "hehe-unpack"
    },
    "nsis": {
      "artifactName": "hehe-toolbox-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "核核工具箱",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false,
    "compression": "maximum",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
