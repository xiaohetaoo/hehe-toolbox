node_modules/
dist/
dist-build/
shot-*.png
*.log
diag-*
_seg*
# asar extract-file 会把文件解到当前目录，防止误提交
/app.js
/main.js
/preload.js
*.asar
# 打包校验时解压出来的临时目录（DSH 监视器偶尔会锁住里面的 asar 删不掉）
.verify-unpacked/
.tmp-smoke*/
.DS_Store
Thumbs.db
# 审查时的临时探测脚本目录
.tmp-audit/
# 本轮改造用的临时验证脚本与日志（探针、一次性归类脚本、验证日志）。
# 与 .tmp-audit/ 同类：价值在跑过一次的结论，不在留在仓库里。
.tmp-probe/
# 迁移/改造期的一次性辅助脚本与备份（与 .tmp-probe 同类）
.tmp-work/
# 一次性调试脚本：排查时随手写的复现，不进仓库（避免像 _tmp-check-* 那样残留）
scripts/_tmp-*.js
# e2e 测试会临时解出的应用目录 / 校验产物（防止误提交几百 MB）
dl-verify/
.ciunpack/
.e2e-*/
# 本地打包暂存（build-portable.sh 默认放工作区外，但写错参数时可能落到这里）
.hehe-build-stage/
# 查 CI 状态时 curl 下来的临时 JSON/HTML（曾经误提交过三次，加规则防再犯）
cr*.json
an*.json
j2.json
g.json
r.json
rel*.json
ci*.html
# 外部工具的记忆目录（非本项目产物）
.workbuddy/
.shots/
.smoke-data/
# check-assertion-count.js 的中间产物（完整测试输出，几十 MB）
reports/
.git-msg.txt
.gm.txt
.m.txt
.msg.txt
# 真机测试与排查时用的临时探针/截图/日志目录（349 个一次性文件，不进仓库）
.realrun/
.tmp-*/
